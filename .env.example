# Copy to .env (gitignored). Values here are placeholders, never real secrets.

# Supabase project (hosted). Dashboard > Project Settings > API / Database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Postgres connection (pooler URI, transaction mode). Used by the server and `pnpm db:migrate`.
DATABASE_URL=

# Local disposable Postgres for tests (docker compose). Database name MUST end with _test.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:54329/dentistas_test

# Shared secret the scheduler sends as `Authorization: Bearer <CRON_SECRET>` to /api/cron/tick.
CRON_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts Google refresh tokens.
TOKEN_ENC_KEY=
# Public base URL of the deployment, no trailing slash (OAuth redirect + links).
APP_URL=http://localhost:3000

# Google OAuth client (Cloud Console > APIs & Services > Credentials), step 11.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp Cloud API (Meta developer app), step 10 and 17. WHATSAPP_MODE=simulator needs none of the rest.
WHATSAPP_MODE=simulator
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Anthropic API, step 16.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
